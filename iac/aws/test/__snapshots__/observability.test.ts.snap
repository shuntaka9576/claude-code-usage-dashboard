    "QueryApiErrors24337524": {
      "Properties": {
        "LogGroupNames": [
          {
            "Ref": "EventsLogGroupEB594EE7",
          },
        ],
        "Name": "claude-code/api-errors",
        "QueryString": "fields @timestamp, attributes.model, attributes.error, attributes.status_code
| filter body = 'claude_code.api_error'
| sort @timestamp desc
| limit 50",
      },
      "Type": "AWS::Logs::QueryDefinition",
    },
    "QueryDailyCost3537C1BE": {
      "Properties": {
        "LogGroupNames": [
          {
            "Ref": "EventsLogGroupEB594EE7",
          },
        ],
        "Name": "claude-code/daily-cost",
        "QueryString": "filter body = 'claude_code.api_request'
| stats sum(attributes.cost_usd) as cost_usd by bin(1d) as day
| sort day desc",
      },
      "Type": "AWS::Logs::QueryDefinition",
    },
    "QueryDailyTokenUsageA84B6C6F": {
      "Properties": {
        "LogGroupNames": [
          {
            "Ref": "EventsLogGroupEB594EE7",
          },
        ],
        "Name": "claude-code/daily-token-usage",
        "QueryString": "filter body = 'claude_code.api_request'
| stats sum(attributes.input_tokens) as input, sum(attributes.output_tokens) as output, sum(attributes.cache_read_tokens) as cache_read, sum(attributes.cache_creation_tokens) as cache_creation by bin(1d) as day
| sort day desc",
      },
      "Type": "AWS::Logs::QueryDefinition",
    },
    "QuerySkillActivationsE709FDC4": {
      "Properties": {
        "LogGroupNames": [
          {
            "Ref": "EventsLogGroupEB594EE7",
          },
        ],
        "Name": "claude-code/skill-activations",
        "QueryString": "fields @timestamp, attributes.skill.name, attributes.invocation_trigger, attributes.skill.source
| filter body = 'claude_code.skill_activated'
| sort @timestamp desc
| limit 50",
      },
      "Type": "AWS::Logs::QueryDefinition",
    },
    "QuerySkillCostEEF0D161": {
      "Properties": {
        "LogGroupNames": [
          {
            "Ref": "EventsLogGroupEB594EE7",
          },
        ],
        "Name": "claude-code/skill-cost",
        "QueryString": "filter body = 'claude_code.api_request' and ispresent(attributes.skill.name)
| stats sum(attributes.cost_usd) as cost_usd, sum(attributes.output_tokens) as output_tokens by attributes.skill.name as skill
| sort cost_usd desc",
      },
      "Type": "AWS::Logs::QueryDefinition",
    },
    "QueryToolUsageSummaryF106A70A": {
      "Properties": {
        "LogGroupNames": [
          {
            "Ref": "EventsLogGroupEB594EE7",
          },
        ],
        "Name": "claude-code/tool-usage-summary",
        "QueryString": "filter body = 'claude_code.tool_result'
| stats count(*) as calls, avg(attributes.duration_ms) as avg_ms, sum(attributes.success = 'false') as failures by attributes.tool_name as tool
| sort calls desc",
      },
      "Type": "AWS::Logs::QueryDefinition",
    },
  },
  "Rules": {
    "CheckBootstrapVersion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Contains": [
                  [
                    "1",
                    "2",
                    "3",
                    "4",
                    "5",
                  ],
                  {
                    "Ref": "BootstrapVersion",
                  },
                ],
              },
            ],
          },
          "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI.",
        },
      ],
    },
  },
}
